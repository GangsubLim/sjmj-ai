# SP1 오프라인 CLI 입력 경로 (실제 값은 .env로 두며 gitignore 됨)
# 이미지/라벨/references 루트 (하위에 images/ labels/ references/)
SJMJ_DATA_DIR=/absolute/path/to/sjmj image
# 운영 DB 백업 (.sql)
SJMJ_DB_BACKUP=/absolute/path/to/SJMJ-Web/database/db-2026-06-24-backup.sql

# tools/curation_report — 배포 서버 큐레이션 데이터 분석 (미설정 시 아래 기본값 사용)
# SJMJ_SSH_HOST=macmini                            # ssh 별칭(~/.ssh/config)
# SJMJ_REMOTE_BACKEND_ENV=~/.sjmj-ai/backend.env   # 원격 DB 접속값 env 파일
# SJMJ_REMOTE_WORKER_ENV=~/.sjmj-ai/ml-worker.env  # 원격 worker venv/모델 경로 env 파일

# tools/bank_update — macmini에서 실행. 아래 두 값은 ml-worker env를 로드해 주입한다.
# set -a; source ~/.sjmj-ai/ml-worker.env; set +a
# SJMJ_ML_MODELS_DIR=/Users/submini/sjmj-ai-models   # bank.npz · ft_prod.pt
# SJMJ_DATA_DIR=/Users/submini/sjmj-ai-data          # ocr_crops/job-*/row-*.png
# SJMJ_BACKEND_ENV=~/.sjmj-ai/backend.env            # 운영 DB 접속값(기본값)
